%%%%% My notes %%%%%
% Use \RequirePackage instead of \usepackage
\NeedsTeXFormat{LaTeX2e}[1994/06/01]
\ProvidesPackage{thesis}
  [2020/03/21 v0.01 LaTeX package for KNU's Master of Science Thesis]

% Document spacing
\RequirePackage[paperwidth=190mm,paperheight=260mm,left=20mm,right=20mm,top=30mm,bottom=30mm,headheight=12pt]{geometry}

%%%%%%%%%%%%
% Packages %
%%%%%%%%%%%%
% Date
\RequirePackage[USenglish]{babel}
\RequirePackage[useregional]{datetime2}
\RequirePackage{lipsum}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Section with Roman Numerals %
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\RequirePackage{fontspec} % Requires xelatex compiler
% Unicode Times-compatible font; keep XeLaTeX Unicode encoding for ko.TeX.
\setmainfont{TeX Gyre Termes}
\RequirePackage{kotex} % for korean text
% Use the bundled Batang font for Korean body text.
% Hangul has no small-cap forms; retain ordinary Hangul in small-cap headings.
\setmainhangulfont{batang.ttc}[
  Path = fonts/, AutoFakeBold = 2.5, AutoFakeSlant = 0.2,
  SmallCapsFont = batang.ttc, SmallCapsFeatures = {Letters = ResetAll}
]
\RequirePackage[subfigure]{tocloft}
\RequirePackage{titlesec}
\RequirePackage{chngpage}
\RequirePackage{fontspec}
\RequirePackage{slantsc} % http://mirrors.ibiblio.org/CTAN/macros/latex/contrib/slantsc/slantsc.pdf
\RequirePackage{bold-extra} % allows for bfseries and scshape to be used together

\renewcommand{\thesection}{\Roman{section}}
\renewcommand{\thesubsection}{\arabic{section}.\arabic{subsection}}
\renewcommand{\thesubsubsection}{\arabic{section}.\arabic{subsection}.\arabic{subsubsection}}
\titleformat{\section}
  {\fontsize{18pt}{21.6pt}\centering\bfseries\scshape}{\thesection.}{1em}{}

%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Section depth, Contents %
%%%%%%%%%%%%%%%%%%%%%%%%%%%
\setcounter{secnumdepth}{5}
\setcounter{tocdepth}{3}
\titleformat{\paragraph}
{\normalfont\normalsize\bfseries}{\theparagraph}{1em}{}
\titlespacing*{\paragraph}
{0pt}{3.25ex plus 1ex minus .2ex}{1.5ex plus .2ex}

\titleformat{\subparagraph}
{\normalfont\normalsize\bfseries}{\thesubparagraph}{1em}{}
\titlespacing*{\subparagraph}
{0pt}{3.25ex plus 1ex minus .2ex}{1.5ex plus .2ex}

\renewcommand{\cftsecaftersnum}{.}
\renewcommand{\cftsecleader}{\cftdotfill{\cftdotsep}}
\renewcommand{\contentsname}{\begin{center}Contents\end{center}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% List of Figures and Tables %
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\setlength{\cftfigindent}{0pt}
\setlength{\cfttabindent}{0pt}
\renewcommand{\cftfigpresnum}{Figure~}
\renewcommand{\cftfignumwidth}{5em}
\renewcommand{\cfttabpresnum}{Table~}
\renewcommand{\cfttabnumwidth}{4.5em}

%%%%%%%%%%%%%%%%
% Custom fonts %
% 1. Converting Regular to Italic fonts:
%    1. Download https://glyphsapp.com/
%    2. Filter > Transformations > 10degree slant (https://glyphsapp.com/tutorials/easy-oblique)
%
% 2.1 Useful link ("Toying with fonts": http://huisaddison.com/blog/fonts-in-latex.html)
% 2.2. usefont parameters: https://www.latex-project.org/help/documentation/fntguide.pdf
%\usefont{<encoding>}{<family>}{<series>}{<shape>}
% encoding: T1
% m: medium, b: bold, eb: extra bold, ub: ultra bold
% n: normal, it: italic
% mdseries = normal weight
% bfseries = bold
%%%%%%%%%%%%%%%%

% Title font

% Batang has no separate bold face; register a synthetic bold shape.
\newfontfamily{\titlefontfamily}{batang}[Extension = .ttc, Path = fonts/, AutoFakeBold = 2.5]
% The bundled file already contains italic glyphs; register it as the italic face.
\newfontfamily{\titlefontitfamily}{unbatang-IT}[
  Extension = .ttf, Path = fonts/, ItalicFont = *, Ligatures=TeX
]


\newcommand*{\titlefontregular}{\titlefontfamily}
\newcommand*{\titlefont}{\titlefontfamily\bfseries}
\newcommand*{\titlefontit}{\titlefontitfamily\itshape}

% Footer font
\newfontfamily{\footerfontfamily}{malgungothic}[Extension = .ttf, Path = fonts/, UprightFont = *-R, BoldFont = *-BD, ItalicFont = *-IT, Ligatures=TeX]
\newcommand*{\footerfontregular}{\footerfontfamily\mdseries}
\newcommand*{\footerfont}{\footerfontfamily\bfseries}
\newcommand*{\footerfontitalic}{\footerfontfamily\itshape}

% Word reference: Times New Roman, regular weight. Keep the body font intact.
\IfFontExistsTF{Times New Roman}
  {\newfontfamily\coverfont{Times New Roman}}
  {\newfontfamily\coverfont{TeX Gyre Termes}}
% Positions measured from the supplied PDF, expressed as fractions of
% page height for the original 190 x 260 mm thesis format.
% Font sizes remain physical sizes; text is never scaled to fit.
\RequirePackage{tikz}
\newsavebox{\frontcontent}
\newcommand{\frontposition}[3]{%
  \sbox{\frontcontent}{\begin{minipage}{\dimexpr\paperwidth-40mm\relax}
    \centering\setstretch{1}\setlength{\parskip}{0pt}
    #3\par
  \end{minipage}}%
  \ifdim\dimexpr\ht\frontcontent+\dp\frontcontent\relax>#2\paperheight
    \PackageWarning{thesis}{Front-page block at #1 exceeds its reserved height}%
  \fi
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=north,inner sep=0pt,outer sep=0pt]
      at ([yshift=-#1\paperheight]current page.north)
      {\usebox{\frontcontent}};
  \end{tikzpicture}%
}
\newcommand*{\frontblock}[3]{%
  {\fontsize{#1}{#2}\selectfont #3\par}%
}
\newcommand*{\approvalstamp}{%
  \tikz[baseline=(seal.base)]{
    \node[draw,circle,inner sep=0.3pt,line width=0.3pt]
      (seal){\titlefontregular\fontsize{8bp}{8bp}\selectfont 인};}%
}
\renewcommand*{\author}[1]{\gdef\@author{#1}}
\newcommand*{\supervisor}[1]{\gdef\@supervisor{#1}}
\newcommand*{\department}[1]{\gdef\@department{#1}}
\renewcommand*{\title}[1]{\gdef\@title{#1}}
\newcommand*{\submitdate}[1]{\gdef\@submitdate{#1}}
\newcommand*{\makecover}{%
  \begin{titlepage}
    \coverfont\mdseries
    \frontposition{.118}{.05}{\frontblock{12bp}{14.4bp}{Thesis for the Degree of Master of Science}}
    \frontposition{.211}{.15}{\frontblock{21bp}{29.4bp}{\@title}}
    \frontposition{.395}{.10}{\frontblock{12bp}{20bp}{\@department\\The Graduate School}}
    \frontposition{.517}{.05}{\frontblock{14bp}{16.8bp}{\@author}}
    \frontposition{.819}{.04}{\frontblock{12bp}{14.4bp}{\@submitdate}}
    \frontposition{.874}{.09}{\frontblock{16bp}{20.5bp}{The Graduate School\\Kyungpook National University}}
    \null
  \end{titlepage}
}

\newcommand*{\profA}[1]{\gdef\@profA{#1}}
\newcommand*{\profB}[1]{\gdef\@profB{#1}}
\newcommand*{\profC}[1]{\gdef\@profC{#1}}
\newcommand*{\makeinnercover}{%
  \begin{titlepage}
    \coverfont\mdseries
    \frontposition{.116}{.10}{\frontblock{21bp}{29.4bp}{\@title}}
    \frontposition{.247}{.04}{\frontblock{14bp}{16.8bp}{\@author}}
    \frontposition{.302}{.08}{\frontblock{12bp}{20bp}{\@department\\The Graduate School}}
    \frontposition{.386}{.075}{\frontblock{12bp}{16bp}{Supervised by Professor \@supervisor}}
    \frontposition{.571}{.095}{\frontblock{12bp}{22bp}{Approved as a qualified thesis of \@author\\
      for the degree of Master of Science\\by the Evaluation Committee}}
    \frontposition{.679}{.04}{\frontblock{12bp}{14.4bp}{\@submitdate}}
    \frontposition{.733}{.14}{%
      \fontsize{12bp}{15bp}\selectfont
      \hfill\begin{tabular}{@{}r@{\hspace{3mm}}c@{\hspace{1mm}}c@{}}
        Chairman & \underline{\makebox[58mm]{\@profA}} & \approvalstamp\\[7mm]
                 & \underline{\makebox[58mm]{\@profB}} & \approvalstamp\\[7mm]
                 & \underline{\makebox[58mm]{\@profC}} & \approvalstamp
      \end{tabular}\hspace*{7mm}}
    \frontposition{.884}{.08}{\frontblock{14bp}{20bp}{The Graduate School Council\\Kyungpook National University}}
    \null
  \end{titlepage}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%  Abstract header - English %
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand*{\makeabstractheader}{%
    \vspace{\baselineskip}
    \begin{table}[h!]
    \centering
        \begin{tabular}{p{10cm}}
            {\centering\setstretch{1.5}\fontsize{14pt}{16.8pt}\titlefont{\@title}\par}
        \end{tabular}
    \end{table}

    \setstretch{1}
    \begin{Center}
    {\fontsize{12pt}{14.8pt}\titlefont{\@author}\par}
    \end{Center}\par

    \vspace{0.2cm}
    \begin{Center}
    {\fontsize{12pt}{14.8pt}\titlefontit{\@department \\ The Graduate School}}
    \end{Center}

    \begin{Center}
    {\fontsize{12pt}{14.8pt}\titlefontit{(Supervised by Professor \@supervisor)}\par}
    \end{Center}\par

    \vspace{\baselineskip}
    \setstretch{2.0}
    \begin{FlushLeft}
    {\fontsize{12pt}{14.8pt}\titlefontit{(Abstract)}\par}
    \end{FlushLeft}\par
}

