%  Abstract header - Korean %
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand*{\authorkorean}[1]{\gdef\@authorkorean{#1}}
\newcommand*{\supervisorkorean}[1]{\gdef\@supervisorkorean{#1}}
\newcommand*{\departmentkorean}[1]{\gdef\@departmentkorean{#1}}
\newcommand*{\titlekorean}[1]{\gdef\@titlekorean{#1}}
\newcommand*{\makeabstractheaderkorean}{%
  \begingroup
    \frontposition{.119}{.055}{%
      \titlefont\frontblock{12bp}{15.6bp}{\@titlekorean}}
    \frontposition{.193}{.05}{%
      \titlefont\frontblock{10bp}{12bp}{\@authorkorean}}
    \frontposition{.258}{.085}{%
      \titlefontregular\frontblock{9bp}{14bp}{%
        \@departmentkorean\\(지도교수 \@supervisorkorean)}}
    \frontposition{.375}{.04}{%
      \raggedright\hspace*{4mm}\titlefontregular
      \fontsize{12bp}{15.6bp}\selectfont (초\quad 록)\par}
  \endgroup
  % Reserve the overlay header's space in the normal text flow.
  \par\vspace*{\dimexpr.425\paperheight-30mm-\baselineskip\relax}
}

